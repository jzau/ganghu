{
  "name": "ai-chat-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ai-chat/api & npm run dev --workspace @ai-chat/web",
    "build": "npm run build --workspace @ai-chat/shared && npm run prisma:generate && npm run build --workspace @ai-chat/api && npm run build --workspace @ai-chat/web",
    "search:compare": "npm run search:compare --workspace @ai-chat/api --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "prisma:seed": "tsx apps/api/prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}

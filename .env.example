DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_chat_app?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
VITE_APP_NAME_EN="GANGHU AI"
VITE_APP_NAME_ZH="工夫 AI"
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_PASSWORD="change-me"
AUTH_SERVICE_ENABLED=false
AUTH_SERVICE_BASE_URL="http://localhost:5000"
AUTH_SERVICE_APP_ID=""
AUTH_SERVICE_API_KEY=""
AUTH_TEST_OTP=""
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL="http://localhost:5173"
OPENROUTER_APP_NAME="AI Chat App"
# Comma-separated credentials issued by Gangram to Toking. Leave empty to disable the provider API.
TOKING_PROVIDER_API_KEYS=""
TOKING_PROVIDER_CONTRACT_VERSION="1"
TAVILY_API_KEY=""
TAVILY_BASE_URL="https://api.tavily.com"
ALIYUN_IQS_API_KEY=""
ALIYUN_IQS_BASE_URL="https://cloud-iqs.aliyuncs.com/search"
ALIYUN_IQS_ENGINE_TYPE="LiteAdvanced"
BAIDU_QIANFAN_API_KEY=""
BAIDU_QIANFAN_BASE_URL="https://qianfan.baidubce.com"
PERPLEXITY_API_KEY=""
PERPLEXITY_BASE_URL="https://api.perplexity.ai"
DOUBAO_SEARCH_API_KEY=""
DOUBAO_SEARCH_BASE_URL="https://open.feedcoopapi.com"
SEARCH_PRIMARY_PROVIDER="tavily"
SEARCH_PLANNER_MODEL="deepseek/deepseek-v4-flash"
SEARCH_PLANNER_FALLBACK_MODEL="openai/gpt-5.6-luna"
SEARCH_PLANNER_TIMEOUT_MS=12000
SEARCH_PLANNER_MAX_TOKENS=500
SEARCH_TIMEOUT_MS=8000
SEARCH_MAX_RESULTS=5
AGENT_RUN_TIMEOUT_MS=60000

# Shared payment service. Keep false by default; enable for the POC after configuring the fields below.
PAYMENT_SERVICE_ENABLED=false
# Optional local POC shortcut. Never use this in production.
# PAYMENT_SERVICE_ENV_FILE=/absolute/path/to/payment-service/.env
# Service origin only, without /api/payments
PAYMENT_SERVICE_BASE_URL=
# Must match payment-service INTERNAL_AUTH_SECRET
PAYMENT_SERVICE_INTERNAL_SECRET=
# Must match payment-service CORE_SERVICE_API_KEY (used on outbound callbacks)
PAYMENT_CALLBACK_SECRET=
# Public chatbot API origin; callback is /api/payments/callback
PAYMENT_PUBLIC_API_URL=
# POC example: USD 10 adds 10,000 app tokens. Replace when commercial pricing is decided.
PAYMENT_OFFERS_JSON=[{"id":"poc-usd-10","amountMinor":1000,"currency":"USD","appTokenAmount":10000}]
# Hosted checkout methods only. OmiPay currently requires USD.
PAYMENT_METHODS_JSON=[{"id":"omipay","label":"OmiPay","labelZh":"OmiPay 扫码支付","provider":"omipay","currencies":["USD"]},{"id":"paypal","label":"PayPal","labelZh":"PayPal","provider":"paypal","currencies":["USD"]}]
